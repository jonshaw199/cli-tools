#!/usr/bin/env bash
# gh-img — upload an image to GitHub's user-attachments CDN and print its URL.
# The URL renders inline in issues/PRs/comments (for repo members) and stays OUT of
# your git history — the same thing a browser drag-drop does, scriptable.
#
# Usage:  gh-img <image> [--repo owner/name]
#   --repo defaults to the current directory's repo.
# Needs:  gh (authenticated), curl, jq.
set -euo pipefail

img="${1:-}"
[ -n "$img" ] || { echo "usage: gh-img <image> [--repo owner/name]" >&2; exit 1; }
[ -f "$img" ] || { echo "gh-img: no such file: $img" >&2; exit 1; }

repo=""
if [ "${2:-}" = "--repo" ]; then repo="${3:?--repo needs owner/name}"; fi
[ -n "$repo" ] || repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
[ -n "$repo" ] || { echo "gh-img: no repo — run inside a repo or pass --repo owner/name" >&2; exit 1; }

name="$(basename "$img")"
case "${name##*.}" in
  png) ct=image/png ;; jpg|jpeg) ct=image/jpeg ;; gif) ct=image/gif ;;
  webp) ct=image/webp ;; *) ct=application/octet-stream ;;
esac

token="$(gh auth token)"
rid="$(gh api "repos/$repo" --jq .id)"
url="$(curl -fsS "https://uploads.github.com/user-attachments/assets?name=$name&content_type=$ct&repository_id=$rid" \
        -X POST -H "Authorization: Bearer $token" -H "Accept: application/json" \
        --data-binary "@$img" | jq -r '.url // empty')"

[ -n "$url" ] || { echo "gh-img: upload failed" >&2; exit 1; }
echo "$url"
